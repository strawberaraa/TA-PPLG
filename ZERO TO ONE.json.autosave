h":54.0,"x":741.0,"y":276.0,"zOrder":8,"numberProperties":[],"stringProperties":[],"initialVariables":[]},{"angle":0.0,"customSize":true,"depth":0.0,"height":76.0,"keepRatio":true,"layer":"ui","name":"healthbar","persistentUuid":"03ff81a7-1b18-4fe2-b3ff-691a3478fc42","width":250.0,"x":70.0,"y":18.0,"zOrder":28,"numberProperties":[],"stringProperties":[],"initialVariables":[]}],"objects":[],"objectsFolderStructure":{"folderName":"__ROOT"},"events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// ===== ZERO TO ONE (versi tahan error) =====","const scene = runtimeScene;","const game = scene.getGame();","const im = game.getInputManager();","const O = (n) => scene.getObjects(n) || [];","const lives = () => game.getVariables().get(\"lives\");","","// ---------- PENGATURAN LEVEL (ubah per level) ----------","const TARGET = 5;                // level 2: 10, level 3: 13","const NEXT_SCENE = \"level 2\";    // scene tujuan setelah gate","const IS_FIRST_LEVEL = true;     // true hanya di level 1","const GAMEOVER_SCENE = \"gameover\";","","// ---------- PENGATURAN OBJEK ----------","const CARD_UI = [\"ui1\", \"grey_button\", \"xbutton\", \"x\", \"cardaccess\"];","const QUIZ_UI = [\"uibuatjawaban\", \"jawaban\", \"SmallGreyButton\", \"soal\", \"systemlocked\", \"inputjawab\", \"xbutton\", \"x\"];","const GATE_OPEN_ANIM = \"open\";       // nama animasi gate terbuka (matikan Loop)","const CARD_GONE_ANIM = \"dissappear\"; // nama animasi card hilang","const FALL_Y = 560;","const HEALTH_BY = \"animation\";       // atau \"frame\"","const ATTACK_MS = 400;","","const safe = (label, fn) => {","  try { fn(); } catch (e) { console.error(\"[ZTO] error di bagian \" + label + \":\", e); }","};","","const player = O(\"character\")[0];","if (!player) { console.error(\"[ZTO] objek 'character' tidak ada di scene\"); return; }","","// cari behavior platformer otomatis","const behList = (obj) => {","  const l = obj._behaviors || [];","  return Array.from(l.values ? l.values() : l);","};","const beh = behList(player).find((b) => typeof b.isOnFloor === \"function\");","if (!beh) { console.error(\"[ZTO] character tidak punya behavior Platformer character\"); return; }","","const now = scene.getTimeManager().getTimeFromStart();","const setVisible = (names, v) => names.forEach((n) => O(n).forEach((o) => o.hide(!v)));","const cx = (o) => o.getX() + o.getWidth() / 2;","const cy = (o) => o.getY() + o.getHeight() / 2;","","const goScene = (name) => {","  const cmd = gdjs.SceneChangeCommand || gdjs.RuntimeScene;","  scene.requestChange(cmd.REPLACE_SCENE, name);","};","","const updateBar = () => {","  const n = lives().getAsNumber();","  O(\"healthbar\").forEach((b) => {","    if (HEALTH_BY === \"frame\") b.setAnimationFrame(n);","    else b.setAnimation(n);","  });","};","const loseLife = () => {","  lives().setNumber(Math.max(0, lives().getAsNumber() - 1));","  updateBar();","  if (lives().getAsNumber() <= 0) goScene(GAMEOVER_SCENE);","};","","// ---------- INISIALISASI (sekali) ----------","if (!scene.__zto) {","  scene.__zto = {","    hasCard: false, puzzleActive: false, puzzleDone: false, mode: null,","    fbUntil: 0, focusNext: false, attackUntil: 0, leaving: false,","    prev: {}, spawnX: player.getX(), spawnY: player.getY(),","  };","  safe(\"init\", () => {","    if (IS_FIRST_LEVEL) lives().setNumber(5);","    setVisible(CARD_UI, false);","    setVisible(QUIZ_UI, false);","    setVisible([\"feedbacktext\"], false);","    updateBar();","    console.log(\"[ZTO] siap. terminal:\", O(\"terminal\").length,","      \"card:\", O(\"card\").length, \"gate:\", O(\"gate\").length,","      \"healthbar:\", O(\"healthbar\").length, \"nyawa:\", lives().getAsNumber());","  });","}","const S = scene.__zto;","if (S.leaving) return;","","// ---------- INPUT ----------","const justPressed = (code) => {","  const down = im.isKeyPressed(code);","  const was = S.prev[code] === true;","  S.prev[code] = down;","  return down && !was;","};","const keyA = justPressed(65);","const keyEnter = justPressed(13);","const keyEsc = justPressed(27);","const clicked = (name) =>","  im.isMouseButtonReleased(0) && O(name).some((o) => o.cursorOnObject(scene));","","const freeze = (f) => beh.activate(!f);","const closePanel = () => {","  setVisible(CARD_UI, false);","  setVisible(QUIZ_UI, false);","  setVisible([\"feedbacktext\"], false);","  S.puzzleActive = false;","  S.mode = null;","  freeze(false);","};","","const nearTerminal = O(\"terminal\").some(","  (t) => Math.hypot(cx(player) - cx(t), cy(player) - cy(t)) < 50",");","const attacking = now < S.attackUntil;","","// ---------- ARAH HADAP + ANIMASI ----------","safe(\"animasi\", () => {","  if (!S.puzzleActive) {","    if (im.isKeyPressed(39)) player.flipX(false);","    if (im.isKeyPressed(37)) player.flipX(true);","  }","  if (!attacking) {","    if (S.puzzleActive) player.setAnimationName(\"idle\");","    else if (beh.isOnFloor()) player.setAnimationName(beh.isMoving() ? \"walk\" : \"idle\");","    else player.setAnimationName(\"jump\");","  }","});","","// ---------- ATTACK ----------","safe(\"attack\", () => {","  if (keyA && !nearTerminal && !S.puzzleActive && !attacking) {","    S.attackUntil = now + ATTACK_MS;","    player.setAnimationName(\"attack\");","  }","});","","// ---------- JATUH ----------","safe(\"jatuh\", () => {","  if (player.getY() > FALL_Y) {","    loseLife();","    player.setPosition(S.spawnX, S.spawnY);","    if (beh.setCurrentFallSpeed) beh.setCurrentFallSpeed(0);","  }","});","","// ---------- CARD ----------","safe(\"card\", () => {","  if (!S.hasCard) {","    for (const card of O(\"card\")) {","      if (gdjs.RuntimeObject.collisionTest(player, card, true)) {","        S.hasCard = true;","        card.setAnimationName(CARD_GONE_ANIM);","        console.log(\"[ZTO] card diambil\");","      }","    }","  } else {","    for (const card of O(\"card\")) {","      if (card.hasAnimationEnded()) card.deleteFromScene(scene);","    }","  }","});","","// ---------- BUKA PANEL TERMINAL ----------","safe(\"terminal\", () => {","  if (keyA && nearTerminal && !S.puzzleActive) {","    console.log(\"[ZTO] A ditekan di terminal, punya card:\", S.hasCard);","    if (!S.hasCard) {","      S.mode = \"card\";","      S.puzzleActive = true;","      setVisible(CARD_UI, true);","      freeze(true);","    } else if (!S.puzzleDone) {","      S.mode = \"quiz\";","      S.puzzleActive = true;","      setVisible(QUIZ_UI, true);","      setVisible([\"feedbacktext\"], false);","      O(\"soal\")[0].setText(","        \"Kode akses (biner):\\n\" + TARGET.toString(2).padStart(8, \"0\") +","        \"\\nMasukkan nilai desimal:\");","      const input = O(\"inputjawab\")[0];","      input.setText(\"\");","      if (input.setDisabled) input.setDisabled(false);","      if (input.setReadOnly) input.setReadOnly(false);","      S.focusNext = true;","      freeze(true);","    }","  }","  if (S.focusNext && S.mode === \"quiz\") {","    const input = O(\"inputjawab\")[0];","    if (input && input.focus) input.focus();","    S.focusNext = false;","  }","});","","// ---------- TUTUP PANEL ----------","safe(\"tutup\", () => {","  if (S.puzzleActive && (keyEsc || clicked(\"xbutton\"))) closePanel();","});","","// ---------- CEK JAWABAN ----------","safe(\"jawaban\", () => {","  if (S.mode !== \"quiz\") return;","  const input = O(\"inputjawab\")[0];","  const submitted = input && input.isSubmitted && input.isSubmitted();","  if (keyEnter || submitted || clicked(\"SmallGreyButton\")) {","    const text = input.getText().trim();","    if (text !== \"\" && Number(text) === TARGET) {","      S.puzzleDone = true;","      closePanel();","      O(\"gate\").forEach((g) => {","        g.setAnimationName(GATE_OPEN_ANIM);","        behList(g).forEach((b) => b.activate(false)); // gate tidak lagi jadi tembok","      });","    } else {","      const fb = O(\"feedbacktext\")[0];","      fb.setText(\"Salah, coba lagi\");","      fb.hide(false);","      input.setText(\"\");","      S.fbUntil = now + 1500;","      loseLife();","    }","  }","});","","safe(\"feedback\", () => {","  if (S.fbUntil && now > S.fbUntil) {","    O(\"feedbacktext\").forEach((o) => o.hide(true));","    S.fbUntil = 0;","  }","});","","// ---------- MASUK GATE ----------","safe(\"gate\", () => {","  if (!S.puzzleDone) return;","  for (const g of O(\"gate\")) {","    if (g.hasAnimationEnded() && gdjs.RuntimeObject.collisionTest(player, g, true)) {","      S.leaving = true;","      goScene(NEXT_SCENE);","      break;","    }","  }","});"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"layers":[{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"bg","renderingType":"","visibility":true,"cameras":[],"effects":[{"effectType":"Scene3D::HemisphereLight","name":"3D Ambient Hemisphere Light","doubleParameters":{"elevation":40.0,"intensity":0.33,"rotation":300.0},"stringParameters":{"groundColor":"127;127;127","skyColor":"255;255;255","top":"Z+"},"booleanParameters":{}},{"effectType":"Scene3D::DirectionalLight","name":"3D Sun Light","doubleParameters":{"distanceFromCamera":1500.0,"elevation":40.0,"frustumSize":4000.0,"intensity":0.75,"minimumShadowBias":0.0,"rotation":300.0},"stringParameters":{"color":"255;255;255","shadowQuality":"medium","top":"Z+"},"booleanParameters":{"isCastingShadow":true}}]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"","renderingType":"","visibility":true,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0.0,"viewport